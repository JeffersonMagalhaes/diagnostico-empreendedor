# DeepSeek API Key (obrigatório)
DEEPSEEK_API_KEY=sk-...

# Chainlit auth secret (gere com: chainlit create-secret)
CHAINLIT_AUTH_SECRET=...

# Cria usuário admin@teste.com / admin123 ao iniciar (apenas dev local)
CREATE_DEFAULT_USER=true

# Diretório de dados persistente (para Railway: /data)
# DATA_DIR=/data
